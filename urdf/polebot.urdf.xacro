<?xml version="1.0"?>
<robot name="polebot_amr" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="base_mass" value="84.837"/>
  <xacro:property name="base_width" value="0.670"/>
  <xacro:property name="base_length" value="1.172"/>
  <xacro:property name="base_height" value="0.563"/>
  
  <xacro:property name="monitor_mass" value="16.008"/>
  <xacro:property name="wheel_mass" value="3.610"/>
  <xacro:property name="wheel_radius" value="0.078"/>
  <xacro:property name="wheel_width" value="0.055"/>
  <xacro:property name="wheel_xoff" value="0.000"/>
  <xacro:property name="wheel_yoff" value="-0.2935"/>
  <xacro:property name="wheel_zoff" value="0.231"/>

  <xacro:property name="caster_mass" value="1.355"/>
  <xacro:property name="caster_radius" value="0.0625"/>
  <xacro:property name="caster_xoff" value="0.300"/> 
  <xacro:property name="caster_yoff" value="-0.0289"/>
  <xacro:property name="caster_zoff" value="0.245"/>   

  <xacro:macro name="box_inertia" params="m w l h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (l*l + h*h)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (w*w + h*h)}" iyz="0.0" izz="${(m/12) * (w*w + l*l)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0" izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5) * m * (r*r)}" ixy="0.0" ixz="0.0" iyy="${(2/5) * m * (r*r)}" iyz="0.0" izz="${(2/5) * m * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + wheel_zoff}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find polebot_telemetry)/meshes/polebot_amr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="polman_blue"><color rgba="0.0 0.0 0.5 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height/2}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" w="${base_width}" l="${base_length}" h="${base_height}"/>
  </link>

  <joint name="monitor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="monitor_link"/>
    <origin xyz="0.204 0 0.730" rpy="0 0 0"/>
  </joint>
  <link name="monitor_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find polebot_telemetry)/meshes/monitor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.15 0.15 0.15 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.1 0.1 0.9"/></geometry>
    </collision>
    <xacro:box_inertia m="${monitor_mass}" w="0.1" l="0.1" h="0.9"/>
  </link>   

  <xacro:macro name="wheel" params="prefix x_reflect y_reflect yaw_flip">
    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_link"/>
      <origin xyz="${x_reflect*wheel_xoff} ${y_reflect*wheel_yoff} ${-wheel_zoff}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${yaw_flip}"/>
        <geometry>
          <mesh filename="file://$(find polebot_telemetry)/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="drivewhl_l" x_reflect="-1" y_reflect="1" yaw_flip="0" />
  <xacro:wheel prefix="drivewhl_r" x_reflect="-1" y_reflect="-1" yaw_flip="${pi}" />

  <xacro:macro name="caster_wheel" params="prefix x_reflect y_reflect">
    <joint name="${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_link"/>
      <origin xyz="${x_reflect*caster_xoff} ${y_reflect*(base_width/2+caster_yoff)} ${-caster_zoff}" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find polebot_telemetry)/meshes/caster.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark_grey"><color rgba="0.15 0.15 0.15 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>        
    </link>
    <gazebo reference="${prefix}_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <slip1>1.0</slip1>
      <slip2>1.0</slip2>
    </gazebo>
  </xacro:macro>

  <xacro:caster_wheel prefix="casterwhl_fl" x_reflect="-1" y_reflect="1" />
  <xacro:caster_wheel prefix="casterwhl_fr" x_reflect="-1" y_reflect="-1" />
  <xacro:caster_wheel prefix="casterwhl_rl" x_reflect="1" y_reflect="1" />
  <xacro:caster_wheel prefix="casterwhl_rr" x_reflect="1" y_reflect="-1" />

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.496 0.0 0.040" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry><mesh filename="file://$(find polebot_telemetry)/meshes/lidar.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.560 0.0 -0.023" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><mesh filename="file://$(find polebot_telemetry)/meshes/camera.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.1" rpy="0 0 0"/>
  </joint>
  
  <link name="imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="black"/>
    </visual>
  </link>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate> <visualize>true</visualize>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>drivewhl_l_joint</joint_name>
      <joint_name>drivewhl_r_joint</joint_name>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
  
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>drivewhl_r_joint</left_joint>
      <right_joint>drivewhl_l_joint</right_joint>
      <wheel_separation>0.587</wheel_separation>
      <wheel_radius>0.078</wheel_radius>
      <max_wheel_torque>200.0</max_wheel_torque>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize> <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>270</samples>
            <resolution>1.0</resolution>
            <min_angle>-2.35619</min_angle>
            <max_angle>2.35619</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>